      "fields": [
        {
          "id": "player",
          "kind": "player",
          "label": "Player"
        }
      ],
      "permission": "players.manage"
    },
    {
      "id": "reload",
      "label": "Read settings again",
      "command": "vanish reload"
    }
  ]
