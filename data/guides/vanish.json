  "title": "Vanish",
  "what": "Lets an operator be invisible: other players can't see them or find them in the player list.",
  "steps": [
    "Operators can also type /vanish in the game to switch it for themselves."
  ],
  "source": "https://github.com/DrexHD/Vanish",
  "checked": "2026-11-20",
  "buttons": [
