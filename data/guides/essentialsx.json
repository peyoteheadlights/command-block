      "command": "seen {player}",
      "fields": [
        {
          "id": "player",
          "kind": "player",
          "label": "Player"
        }
      ]
    },
    {
      "id": "tempban",
      "label": "Ban a player for a while",
      "command": "tempban {player} {time}",
      "fields": [
        {
          "id": "player",
          "kind": "player",
          "label": "Player"
        },
        {
          "id": "time",
