  "versions": ">=2.19.0 <3",
  "title": "EssentialsX",
  "what": "Everyday commands for players: homes, warps, kits, /tpa, nicknames, an economy and more.",
  "steps": [
    "Players use /sethome and /home, /tpa <name> to ask to teleport, and /warp <name>.",
    "An operator makes a warp in the game by standing on the spot and typing /setwarp <name>.",
    "Who may use which command is set with a permissions plugin such as LuckPerms.",
    "The settings are in plugins/Essentials/config.yml (Edit settings)."
  ],
  "source": "https://github.com/EssentialsX/Essentials/blob/2.x/Essentials/src/main/resources/plugin.yml",
  "checked": "2026-10-31",
  "buttons": [
